<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration du service d'accessibilité CamAPS.
    Il se limite aux changements de fenêtre et de contenu : de quoi lire l'écran « Ajouter un
    repas » quand l'automatisation le demande, sans surveillance permanente. Il peut écrire dans
    le champ des glucides et cocher le type de repas, mais jamais valider un bolus.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/camaps_accessibility_description"
    android:notificationTimeout="100" />
