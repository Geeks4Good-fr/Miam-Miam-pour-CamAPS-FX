<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème « coquille » : l'interface réelle est en Compose (Material 3).
      On garde un thème système minimal pour éviter la dépendance à AppCompat.
    -->
    <style name="Theme.MealAnnouncer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
